# LLM provider: local | browser_use | openai | anthropic
LLM_PROVIDER=local

# Local OpenAI-compatible (LM Studio / Ollama)
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=lm-studio
# LM Studio example: qwen/qwen3.6-35b-a3b  |  Ollama: qwen2.5:7b
LLM_MODEL=qwen/qwen3.6-35b-a3b

# Cloud keys (set the ones you use)
BROWSER_USE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# App
HOST=127.0.0.1
PORT=8742
MAX_CONCURRENT_AGENTS=2
DATA_DIR=../data
HEADLESS=true
# Browser engine: chromium | chrome | custom
# chromium = Playwright Chrome-for-Testing / headless-shell (recommended)
# chrome   = installed Google Chrome
# custom   = path in BROWSER_EXECUTABLE (or CHROME_PATH)
BROWSER_ENGINE=chromium
BROWSER_EXECUTABLE=
# CHROME_PATH=/path/to/custom/chrome

# Default start URL when a task omits a link (overridable per run as Runtime URL)
APPLICATION_URL=https://duckduckgo.com

# Optional login for Application URL (browser agent fills forms when needed)
# APPLICATION_USERNAME=
# APPLICATION_PASSWORD=

